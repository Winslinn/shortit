[Unit]
Description=url shortener on uvicorn
After=network-online.target

[Service]
User=winslinn
WorkingDirectory=/opt/shortit
Environment="APP_HOSTNAME=winslinn.dpdns.org"
EnvironmentFile=-/etc/shortit/turnstile.env
EnvironmentFile=-/etc/shortit/google_cloud.env
Environment="TURNSTILE_HOSTNAMES=winslinn.dpdns.org"
ExecStart=/opt/shortit/.venv/bin/uvicorn shortit.main:app --app-dir /opt/shortit/src \
 --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always

[Install]
WantedBy=multi-user.target
